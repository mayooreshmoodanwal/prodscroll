NODE_ENV=development
DATABASE_URL=postgresql://productscroll:productscroll@localhost:5432/productscroll?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
PORT=3000
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api
# Vercel production: set NEXT_PUBLIC_API_URL=/api and API_PROXY_ORIGIN=https://your-api.example.com.
# Point realtime sockets directly at the backend; REST stays same-origin through Next rewrites.
NEXT_PUBLIC_SOCKET_URL=
API_PROXY_ORIGIN=
SESSION_SECRET=replace-with-at-least-32-random-bytes-before-deployment
JWT_SECRET=replace-with-at-least-32-random-bytes-before-deployment
MEDIA_DRIVER=local
MEDIA_DIR=../../work/media
MEDIA_PUBLIC_URL=http://localhost:4000/media
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=ProductScroll <hello@productscroll.local>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# Cloudflare R2: leave blank for zero-cost local development.
# Set MEDIA_DRIVER=r2 only after creating two PRIVATE buckets and the media Worker.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_UPLOAD_BUCKET=productscroll-incoming
R2_MEDIA_BUCKET=productscroll-media
R2_DELIVERY_URL=
MEDIA_DELIVERY_SECRET=
PUSH_PROVIDER=local
# Local provider writes verification and login emails to work/mail.
EMAIL_DRIVER=local
# Optional absolute locations; default paths are relative to apps/api or apps/worker.
MAIL_DIR=../../work/mail
PUSH_DIR=../../work/push
# Optional production metrics scraper secret; metrics are denied when unset.
METRICS_TOKEN=
TRUST_PROXY=false
LOG_LEVEL=info
# Optional system FFmpeg binaries, especially in production containers.
FFMPEG_PATH=
FFPROBE_PATH=
# Space-separated exact R2 upload/media Worker origins used by browser upload/HLS fetches.
NEXT_PUBLIC_UPLOAD_ORIGINS=

# Per-process PostgreSQL connection budget; multiply by API and worker replicas.
DATABASE_POOL_SIZE=5
# Separate worker pools prevent transcoding from delaying other jobs.
WORKER_QUEUES=default,media,events,fanout
WORKER_MEDIA_CONCURRENCY=1
WORKER_EVENTS_CONCURRENCY=4
WORKER_DEFAULT_CONCURRENCY=8
WORKER_FANOUT_CONCURRENCY=1
# Stop accepting new uploads before an overloaded media queue grows unbounded.
MEDIA_QUEUE_MAX_BACKLOG=200
MAX_WEBSOCKET_BUFFER_BYTES=1048576

API_RATE_LIMIT=240
# Counters update transactionally; full repair is an opt-in maintenance operation.
ENABLE_COUNTER_RECONCILIATION=false
